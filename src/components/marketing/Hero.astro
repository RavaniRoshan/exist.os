---
import { marketing } from "../../content/marketing";
const { hero } = marketing;
const base = import.meta.env.BASE_URL;
---

<section class="pt-16 pb-16 md:pt-24 md:pb-24">
  <div class="shell">
    <h1 class="display max-w-4xl" data-reveal>{hero.title}</h1>

    <p class="lead mt-7 max-w-2xl" data-reveal>{hero.body}</p>

    <div class="mt-9 flex flex-wrap items-center gap-7" data-reveal>
      <a class="btn btn-primary" href={hero.primary.href}>{hero.primary.label}</a>
      <a class="text-link" href={hero.secondary.href}>
        {hero.secondary.label}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <p class="small mt-7" data-reveal>{hero.note}</p>

    <figure class="mt-14 overflow-hidden md:mt-20" data-reveal>
      <img
        src={`${base}/forge-pr.png`}
        alt={hero.screenshotAlt}
        width="1280"
        height="800"
        class="hero-drift w-full"
        loading="eager"
      />
      <figcaption class="small mt-4">A real pull request in the Forge UI.</figcaption>
    </figure>
  </div>
</section>
