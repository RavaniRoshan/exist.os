---
import { marketing } from "../../content/marketing";
const { hero, loop } = marketing;
const cx = 280;
const cy = 250;
const radius = 176;
const angles = [-90, -30, 30, 90, 150, 210];
const nodes = loop.steps.map((step, index) => {
  const angle = (angles[index] * Math.PI) / 180;
  const x = cx + radius * Math.cos(angle);
  const y = cy + radius * Math.sin(angle);
  const labelRadius = 224;
  const lx = cx + labelRadius * Math.cos(angle);
  const ly = cy + labelRadius * Math.sin(angle);
  const anchor = Math.cos(angle) > 0.2 ? "start" : Math.cos(angle) < -0.2 ? "end" : "middle";
  const labelY = index === 0 ? 24 : index === 3 ? 494 : ly + 4;
  return { ...step, index, x, y, lx, ly: labelY, anchor };
});
---

<section class="hero-wash relative overflow-hidden border-b border-line">
  <div class="hero-canvas absolute inset-0 z-0" aria-hidden="true"></div>

  <div class="shell relative grid gap-12 pt-14 pb-8 md:grid-cols-[1.02fr_0.98fr] md:items-center md:gap-14 md:pt-24 md:pb-10">
    <div class="min-w-0" data-reveal>
      <p class="small flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-mint" aria-hidden="true"></span>
        {hero.kicker}
      </p>
      <h1 class="display mt-5 max-w-xl">
        {hero.titleLead.split("").map((char, index) => (
          <span class="hero-char" style={{ "--delay": `${index * 0.04}s` }} aria-hidden="true">{char}</span>
        ))}<br /><span class="text-mint">{hero.titleAccent.split("").map((char, index) => (
          <span class="hero-char" style={{ "--delay": `${(hero.titleLead.length + index) * 0.04}s` }} aria-hidden="true">{char}</span>
        ))}</span>
      </h1>
      <p class="lead mt-6 max-w-lg">{hero.body}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="btn btn-primary" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="btn btn-ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>

    <div class="min-w-0" data-reveal>
      <div class="orbit-card card overflow-hidden p-4 md:p-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium">{loop.title}</p>
            <p class="small mt-0.5">{loop.hint}</p>
          </div>
          <span class="tag"><span class="size-1.5 rounded-full bg-mint" aria-hidden="true"></span>live loop</span>
        </div>

        <svg viewBox="0 0 560 520" class="mt-2 w-full" role="group" aria-label="The exist.io agent loop: lease, clone, push, pull request, review, merge">
          <circle cx={cx} cy={cy} r="196" fill="none" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="1 12" opacity="0.7" />
          <circle cx={cx} cy={cy} r={radius} fill="none" stroke="var(--color-line)" stroke-width="1" class="loop-path" />
          <circle cx={cx} cy={cy} r={radius} fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-linecap="round" stroke-dasharray="58 1048" opacity="0.8" class="orbit-spin" />

          <g aria-hidden="true">
            <rect x="196" y="210" width="168" height="80" rx="12" fill="var(--color-paper)" stroke="var(--color-line)" />
            <text x="280" y="234" text-anchor="middle" font-size="10" letter-spacing="1.4" fill="var(--color-ink-3)">CAPABILITY LEASE</text>
            <text x="280" y="260" text-anchor="middle" font-size="22" fill="var(--color-ink)">15:00</text>
            <text x="280" y="278" text-anchor="middle" font-size="10" fill="var(--color-mint)">HMAC-SHA256</text>
            <circle class="hotspot" cx="280" cy="260" r="16" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-opacity="0" pointer-events="all" data-label="Lease duration: 15 minutes" />
          </g>

          {nodes.map((node) => (
            <g
              class="orbit-node"
              data-step={node.id}
              data-title={node.title}
              data-detail={node.detail}
              data-meta={node.meta}
              data-index={node.index}
              data-active={node.index === 0 ? "true" : "false"}
              tabindex="0"
              role="button"
              aria-label={`Step ${node.index + 1}: ${node.title}`}
            >
              <circle class="node-halo" cx={node.x} cy={node.y} r="46" fill="none" stroke="var(--color-mint)" stroke-opacity="0.3" />
              <circle class="node-pulse" cx={node.x} cy={node.y} r="34" fill="none" stroke="var(--color-mint)" stroke-width="1" />
              <circle class="node-dot" cx={node.x} cy={node.y} r="34" fill="var(--color-paper)" stroke="var(--color-line)" />
              <text class="node-num" x={node.x} y={node.y + 4} text-anchor="middle" font-size="12" fill="var(--color-ink)">0{node.index + 1}</text>
              <text x={node.lx} y={node.ly} text-anchor={node.anchor} font-size="12" fill="var(--color-ink-3)">{node.label}</text>
              <circle class="hotspot" cx={node.x} cy={node.y} r="40" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-opacity="0" pointer-events="all" data-label={node.detail} />
            </g>
          ))}
        </svg>

        <div class="mt-1 border-t border-line pt-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="eyebrow" data-loop-count>01 / 06</p>
              <p class="mt-2 text-sm font-medium" data-loop-title>Request a lease</p>
              <p class="small mt-1 min-h-[2.625rem]" data-loop-detail>A short-lived HMAC token scoped to refs/heads/agent/*.</p>
            </div>
            <span class="tag shrink-0">HMAC</span>
          </div>
          <div class="mt-3 flex items-center justify-between gap-3 text-[11px] text-ink-3">
            <code class="min-w-0 truncate" data-loop-meta>POST /api/v1/leases → 15m</code>
            <span class="shrink-0 font-mono uppercase tracking-[0.12em]">auto</span>
          </div>
          <div class="mt-2 h-0.5 w-full overflow-hidden rounded-full bg-line" aria-hidden="true">
            <div class="orbit-track h-full rounded-full bg-mint" data-loop-track style="width:16.6%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="shell relative pb-12 md:pb-16">
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-5">
      <span class="eyebrow shrink-0">Install</span>
      <div class="code-strip min-w-0 flex-1">
        <span class="text-[#8bb8a4]">$</span>
        <code class="min-w-0 flex-1">curl -fsSL <wbr />https://raw.githubusercontent.com/<wbr />RavaniRoshan/exist.io/<wbr />main/scripts/install.sh <wbr />| bash</code>
        <button type="button" class="shrink-0 text-[#b8b5a8] transition-colors hover:text-white" data-copy data-copy-source="#hero-install" data-copied-label="Copied">Copy</button>
        <span id="hero-install" class="sr-only">{hero.install}</span>
      </div>
    </div>
    <p class="small mt-3">{hero.note}</p>
  </div>
</section>
