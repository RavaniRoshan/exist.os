---
import { marketing } from "../../content/marketing";
const { bento } = marketing;
---

<section id="platform" class="py-20 md:py-28">
  <div class="shell">
    <h2 class="heading max-w-2xl" data-reveal>{bento.title}</h2>

    <div class="mt-12 grid gap-x-14 md:grid-cols-2">
      {bento.items.map((item) => (
        <div class="bento-row" data-reveal>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-base font-semibold">{item.title}</h3>
            <span class="small">{item.tag}</span>
          </div>
          <p class="small">{item.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
