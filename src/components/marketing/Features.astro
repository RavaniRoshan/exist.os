---
import { marketing } from "../../content/marketing";
const { features, gate, stack, lease } = marketing;
---

<section id="product" class="border-b border-line">
  <div class="shell py-16 md:py-24">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">{features.eyebrow}</p>
      <h2 class="heading mt-3">{features.title}</h2>
      <p class="body mt-3 max-w-xl">{features.body}</p>
    </div>

    <div class="mt-14 grid gap-16 md:gap-24">
      {features.items.map((feature, index) => (
        <div class:list={["grid items-center gap-10 md:grid-cols-2 md:gap-16", index % 2 === 1 && "md:[&>*:first-child]:order-2"]} id={feature.id}>
          <div class="min-w-0" data-reveal>
            <p class="eyebrow">{feature.eyebrow}</p>
            <h3 class="heading mt-3">{feature.title}</h3>
            <p class="body mt-4">{feature.body}</p>
            <ul class="mt-6 space-y-3">
              {feature.points.map((point) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-2">
                  <span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-mint" aria-hidden="true"></span>
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="min-w-0" data-reveal>
            <div class="feature-node relative" data-toggle>
              {feature.media === "lease" && (
                <div class="card overflow-hidden">
                  <div class="flex items-center justify-between border-b border-line px-5 py-3">
                    <p class="font-mono text-xs text-ink-2">lease_request</p>
                    <span class="tag">HMAC</span>
                  </div>
                  <div class="p-5">
                    <div class="flex items-center gap-6">
                      <div class="relative shrink-0">
                        <svg viewBox="0 0 140 140" class="size-32" aria-hidden="true">
                          <circle cx="70" cy="70" r="56" fill="none" stroke="var(--color-line)" stroke-width="8" />
                          <circle
                            cx="70"
                            cy="70"
                            r="56"
                            fill="none"
                            stroke="var(--color-mint)"
                            stroke-width="8"
                            stroke-linecap="round"
                            transform="rotate(-90 70 70)"
                            data-ttl-ring
                            stroke-dasharray="351.86"
                            stroke-dashoffset="263.9"
                          />
                          <circle class="hotspot" cx="70" cy="70" r="62" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-opacity="0" pointer-events="all" data-label="Lease TTL: 15 minutes, scoped to refs/heads/agent/*" />
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                          <span class="text-2xl font-light leading-none" data-ttl-label>15</span>
                          <span class="mt-1 text-[10px] uppercase tracking-[0.18em] text-ink-3">min</span>
                        </div>
                      </div>
                      <div class="min-w-0">
                        <p class="eyebrow">capability lease</p>
                        <code class="mt-2 block truncate text-sm text-ink">{lease.token}</code>
                        <p class="small mt-2">signed with HMAC-SHA256</p>
                        <p class="small mt-1">dies with the task</p>
                      </div>
                    </div>

                    <label class="mt-6 block">
                      <span class="flex items-center justify-between text-xs text-ink-3">
                        <span>lease ttl</span>
                        <span>5–60 min</span>
                      </span>
                      <input type="range" min="5" max="60" value="15" data-ttl class="mt-2 w-full accent-[var(--color-mint)]" />
                    </label>

                    <dl class="mt-4 divide-y divide-line rounded-md border border-line text-xs">
                      <div class="flex items-center justify-between gap-3 px-3 py-2">
                        <dt class="text-ink-3">scope</dt>
                        <dd class="truncate font-mono text-ink-2">refs/heads/agent/*</dd>
                      </div>
                      <div class="flex items-center justify-between gap-3 px-3 py-2">
                        <dt class="text-ink-3">revocation</dt>
                        <dd class="font-mono text-ink-2">immediate</dd>
                      </div>
                      <div class="flex items-center justify-between gap-3 px-3 py-2">
                        <dt class="text-ink-3">audit</dt>
                        <dd class="font-mono text-ink-2">every action</dd>
                      </div>
                    </dl>

                    <button type="button" data-ttl-renew class="btn btn-ghost mt-4 h-9 w-full text-xs">Renew lease</button>
                  </div>
                </div>
              )}

              {feature.media === "gate" && (
                <div class="card overflow-hidden" data-merge-gate>
                  <div class="flex items-center justify-between border-b border-line px-5 py-3">
                    <p class="font-mono text-xs text-ink-2">merge_gate</p>
                    <span class="tag">policy</span>
                  </div>
                  <div class="p-5">
                    <div class="space-y-2.5">
                      {gate.rows.map((row) => (
                        <label class="flex items-center justify-between gap-3 rounded-md border border-line bg-paper px-3 py-2.5 text-sm">
                          <span class="flex items-center gap-2.5">
                            <input type="checkbox" checked data-gate class="size-4 accent-[var(--color-mint)]" />
                            {row}
                          </span>
                          <span class="text-[11px] text-mint" data-gate-state>passed</span>
                        </label>
                      ))}
                    </div>

                    <div class="mt-4 flex gap-2">
                      <button type="button" data-gate-run class="btn btn-ghost h-9 flex-1 text-xs">Re-run checks</button>
                      <button type="button" data-merge-button class="btn btn-primary h-9 flex-1 text-xs disabled:pointer-events-none disabled:opacity-40">
                        {gate.enabled}
                      </button>
                    </div>

                    <p class="small mt-3" data-merge-status aria-live="polite" data-ready={gate.ready} data-blocked={gate.blocked} data-merged={gate.mergedStatus}>
                      {gate.ready}
                    </p>
                  </div>
                </div>
              )}

              {feature.media === "stack" && (
                <div class="card overflow-hidden">
                  <div class="flex items-center justify-between border-b border-line px-5 py-3">
                    <p class="font-mono text-xs text-ink-2">existd --topology</p>
                    <span class="tag">single process</span>
                  </div>
                  <div class="p-5">
                    <svg viewBox="0 0 520 380" class="w-full" role="img" aria-label="existd architecture: clients and agents, existd, and local disk">
                      <g class="arch-layer" data-arch="clients" data-active="true">
                        <rect class="layer-box" x="30" y="16" width="460" height="86" rx="12" fill="var(--color-paper)" stroke="var(--color-line)" />
                        <text x="54" y="46" font-size="13" fill="var(--color-ink)">{stack.layers[0].label}</text>
                        <text x="54" y="66" font-size="11" fill="var(--color-ink-3)">{stack.layers[0].detail}</text>
                        {stack.chips.clients.map((chip, i) => (
                          <g>
                            <rect x={338 + i * 48} y={52} width="44" height="20" rx="10" fill="var(--color-paper-2)" stroke="var(--color-line)" />
                            <text x={360 + i * 48} y="66" text-anchor="middle" font-size="9" fill="var(--color-ink-3)">{chip}</text>
                          </g>
                        ))}
                      </g>

                      <path d="M180 102v44M260 102v44M340 102v44" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="3 5" />
                      <circle cx="180" cy="102" r="2.5" fill="var(--color-mint)">
                        <animateMotion dur="2.8s" repeatCount="indefinite" path="M0 0 L0 44" />
                      </circle>
                      <circle cx="260" cy="102" r="2.5" fill="var(--color-mint)">
                        <animateMotion dur="2.2s" repeatCount="indefinite" path="M0 0 L0 44" />
                      </circle>
                      <circle cx="340" cy="102" r="2.5" fill="var(--color-mint)">
                        <animateMotion dur="3.4s" repeatCount="indefinite" path="M0 0 L0 44" />
                      </circle>

                      <g class="arch-layer" data-arch="existd">
                        <rect class="layer-box" x="30" y="146" width="460" height="104" rx="12" fill="var(--color-paper)" stroke="var(--color-line)" />
                        <text x="54" y="176" font-size="13" fill="var(--color-ink)">{stack.layers[1].label}</text>
                        <text x="54" y="196" font-size="11" fill="var(--color-ink-3)">{stack.layers[1].detail}</text>
                        {stack.chips.existd.map((chip, i) => (
                          <g>
                            <rect x={286 + i * 64} y="182" width="60" height="20" rx="10" fill="var(--color-paper-2)" stroke="var(--color-line)" />
                            <text x={316 + i * 64} y="196" text-anchor="middle" font-size="9" fill="var(--color-ink-3)">{chip}</text>
                          </g>
                        ))}
                        <text x="54" y="228" font-size="9" fill="var(--color-ink-3)">no external database · no host sshd</text>
                      </g>

                      <path d="M180 250v40M260 250v40M340 250v40" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="3 5" />
                      <circle cx="180" cy="250" r="2.5" fill="var(--color-mint)">
                        <animateMotion dur="3.2s" repeatCount="indefinite" path="M0 0 L0 40" />
                      </circle>
                      <circle cx="260" cy="250" r="2.5" fill="var(--color-mint)">
                        <animateMotion dur="2.6s" repeatCount="indefinite" path="M0 0 L0 40" />
                      </circle>
                      <circle cx="340" cy="250" r="2.5" fill="var(--color-mint)">
                        <animateMotion dur="3.8s" repeatCount="indefinite" path="M0 0 L0 40" />
                      </circle>

                      <g class="arch-layer" data-arch="disk">
                        <rect class="layer-box" x="30" y="290" width="460" height="74" rx="12" fill="var(--color-paper)" stroke="var(--color-line)" />
                        <text x="54" y="318" font-size="13" fill="var(--color-ink)">{stack.layers[2].label}</text>
                        <text x="54" y="338" font-size="11" fill="var(--color-ink-3)">{stack.layers[2].detail}</text>
                        {stack.chips.disk.map((chip, i) => (
                          <g>
                            <rect x={286 + i * 96} y="310" width="92" height="20" rx="10" fill="var(--color-paper-2)" stroke="var(--color-line)" />
                            <text x={332 + i * 96} y="324" text-anchor="middle" font-size="9" fill="var(--color-ink-3)">{chip}</text>
                          </g>
                        ))}
                    </svg>
                    <p class="small mt-4" data-arch-detail>Clients and agents reach existd over HTTP and SSH.</p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>