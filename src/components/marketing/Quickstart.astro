---
import { marketing } from "../../content/marketing";
const { quickstart } = marketing;
---

<section id="quickstart" class="py-20 md:py-28">
  <div class="shell grid items-start gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
    <div class="min-w-0" data-reveal>
      <h2 class="heading">{quickstart.title}</h2>
      <p class="body mt-4">{quickstart.body}</p>
      <div class="mt-7 flex flex-col items-start gap-4">
        <a class="text-link" href={quickstart.docs.href}>
          {quickstart.docs.label}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="text-link" href={quickstart.release.href}>
          {quickstart.release.label}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>

    <div class="terminal min-w-0" data-reveal>
      <div class="terminal-bar">
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <button
          type="button"
          class="ml-auto text-sm text-fg-2 transition-colors hover:text-fg"
          data-copy
          data-copy-source="#quickstart-code"
          data-copied-label="Copied"
        >
          Copy
        </button>
      </div>
      <pre id="quickstart-code" class="overflow-x-auto p-5 text-sm leading-relaxed text-fg-2"><code>{quickstart.commands.join("\n\n")}</code></pre>
      <p class="small px-5 pb-5">{quickstart.caption}</p>
    </div>
  </div>
</section>
