---
import { marketing } from "../../content/marketing";
const { quickstart } = marketing;

const formatCommand = (command: string) =>
  command
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll("/", "/<wbr />")
    .replaceAll(" --", " <wbr />--");
---

<section id="quickstart" class="border-b border-line">
  <div class="shell grid items-start gap-10 py-16 md:grid-cols-[0.85fr_1.15fr] md:gap-16 md:py-24">
    <div data-reveal>
      <p class="eyebrow">{quickstart.eyebrow}</p>
      <h2 class="heading mt-3 max-w-sm">{quickstart.title}</h2>
      <p class="body mt-3 max-w-md">{quickstart.body}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a class="btn btn-ghost" href={quickstart.docs.href}>{quickstart.docs.label}</a>
        <a class="text-xs text-ink-3 underline decoration-line underline-offset-4 transition-colors hover:text-ink" href={quickstart.release.href}>
          {quickstart.release.label} ↗
        </a>
      </div>

      <div class="mt-8 max-w-md rounded-lg border border-line bg-paper-2 p-4">
        <p class="eyebrow">Verify before run</p>
        <p class="small mt-2">
          The installer resolves the newest release, checks its SHA-256 manifest, and refuses to write a binary if verification is unavailable.
        </p>
      </div>
    </div>

    <div class="terminal overflow-hidden rounded-xl border border-black/25 shadow-[0_28px_70px_-32px_rgba(18,18,16,0.5)]" data-reveal>
      <div class="terminal-head">
        <div class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-[#464a44]"></span>
          <span class="size-2 rounded-full bg-[#464a44]"></span>
          <span class="size-2 rounded-full bg-[#464a44]"></span>
          <span class="ml-2 text-[11px] text-[#8f938a]">bash — exist.io</span>
        </div>
        <button
          type="button"
          class="text-[11px] text-[#a5a99f] transition-colors hover:text-white"
          data-copy
          data-copy-source="#quickstart-all"
          data-copied-label="Copied"
        >
          Copy all
        </button>
      </div>

      <div id="quickstart-code">
        {quickstart.steps.map((step, index) => (
          <div class="terminal-step">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[10px] uppercase tracking-[0.16em] text-[#8f938a]">Step 0{index + 1} · {step.label}</span>
              <button
                type="button"
                class="text-[10px] text-[#8f938a] transition-colors hover:text-white"
                data-copy
                data-copy-source={`#quickstart-cmd-${index}`}
                data-copied-label="Copied"
              >
                Copy
              </button>
            </div>
            <div class="terminal-cmd mt-2">
              <span class="prompt" aria-hidden="true">$</span>
              <code id={`quickstart-cmd-${index}`} class:list={[index === quickstart.steps.length - 1 && "terminal-cursor"]} set:html={formatCommand(step.command)}></code>
            </div>
          </div>
        ))}
      </div>

      <p class="border-t border-white/10 px-4 py-3 text-[11px] leading-relaxed text-[#a5a99f]">{quickstart.caption}</p>
      <span id="quickstart-all" class="sr-only">{quickstart.steps.map((step) => step.command).join("\n")}</span>
    </div>
  </div>
</section>
