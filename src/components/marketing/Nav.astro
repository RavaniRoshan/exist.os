---
import { marketing } from "../../content/marketing";
const base = import.meta.env.BASE_URL;
const { announcement, nav } = marketing;
const links = nav.links;
---

<a class="announce block" href={announcement.href}>
  <div class="shell flex h-8 items-center justify-center gap-2 text-[11px] tracking-tight">
    <span class="size-1.5 rounded-full bg-[#7fc2a8]" aria-hidden="true"></span>
    <span class="font-mono">{announcement.tag}</span>
    <span class="text-white/50" aria-hidden="true">·</span>
    <span>{announcement.text}</span>
    <span class="hidden text-white/50 sm:inline" aria-hidden="true">—</span>
    <span class="hidden sm:inline">{announcement.link} →</span>
  </div>
</a>

<header class="nav-blur sticky top-0 z-40 border-b border-line">
  <div class="shell flex h-14 items-center justify-between gap-4">
    <a href={`${base}/`} class="flex items-center gap-2.5 text-sm font-medium tracking-tight" aria-label="exist.io home">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 5v9a4 4 0 0 0 4 4h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        <circle cx="6" cy="4" r="2" fill="currentColor" />
        <circle cx="18" cy="18" r="2" fill="currentColor" />
        <path d="M18 5v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      exist.io
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((link) => (
        <a class="text-sm text-ink-2 transition-colors hover:text-ink" href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-open
        class="hidden h-8 items-center gap-2 rounded-md border border-line px-2.5 text-xs text-ink-3 transition-colors hover:border-ink/25 hover:text-ink sm:flex"
        aria-label="Search"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7" />
          <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        Search
        <kbd class="rounded border border-line px-1 py-0.5 text-[10px] text-ink-3">⌘K</kbd>
      </button>

      <a class="hidden size-8 items-center justify-center rounded-md text-ink-2 transition-colors hover:text-ink sm:flex" href={nav.github} aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.8 18.3 5.1 18.3 5.1c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" />
        </svg>
      </a>

      <a class="btn btn-primary h-8 px-3 text-xs" href="#quickstart">Install</a>

      <button
        type="button"
        data-menu-open
        class="flex size-8 items-center justify-center rounded-md border border-line text-ink-2 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="border-t border-line bg-paper lg:hidden" hidden>
    <nav class="shell flex flex-col py-3" aria-label="Mobile">
      {links.map((link) => (
        <a class="border-b border-line py-3 text-sm text-ink-2 last:border-0" href={link.href}>{link.label}</a>
      ))}
      <button type="button" data-search-open class="flex items-center justify-between border-b border-line py-3 text-left text-sm text-ink-2">
        Search
        <kbd class="rounded border border-line px-1.5 py-0.5 text-[10px] text-ink-3">⌘K</kbd>
      </button>
      <a class="py-3 text-sm text-ink-2" href={nav.github}>GitHub ↗</a>
    </nav>
  </div>
</header>

<dialog id="search-dialog" class="search-dialog w-[min(92vw,34rem)] rounded-xl border border-line bg-paper p-0 text-ink">
  <div class="border-b border-line p-3">
    <input
      type="search"
      data-search-input
      placeholder="Search sections, docs, releases..."
      class="h-9 w-full rounded-md border border-line bg-paper-2 px-3 text-sm outline-none focus:border-mint"
      autocomplete="off"
      aria-label="Search"
    />
  </div>
  <ul class="max-h-80 overflow-y-auto p-2" data-search-list>
    {[
      { text: "Product overview", href: "#product" },
      { text: "Agent loop", href: "#preview" },
      { text: "Capability leases", href: "#agents" },
      { text: "Review and merge gate", href: "#review" },
      { text: "Architecture", href: "#architecture" },
      { text: "Integrations", href: "#platform" },
      { text: "Quickstart", href: "#quickstart" },
      { text: "Documentation", href: "https://ravaniroshan.github.io/exist.io/" },
      { text: "Release notes", href: "https://github.com/RavaniRoshan/exist.io/releases/tag/v0.6.0-beta" },
      { text: "Claims ledger", href: "https://github.com/RavaniRoshan/exist.io/blob/main/CLAIMS.md" },
    ].map((item) => (
      <li data-search-item data-search-text={item.text.toLowerCase()}>
        <a class="flex items-center justify-between rounded-md px-3 py-2 text-sm text-ink-2 hover:bg-paper-2 hover:text-ink" href={item.href}>
          {item.text}
          <span class="text-ink-3">↵</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="border-t border-line px-3 py-2 text-xs text-ink-3">Esc to close</p>
</dialog>
