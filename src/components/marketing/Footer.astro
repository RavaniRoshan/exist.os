---
import { marketing } from "../../content/marketing";
const { footer } = marketing;
---

<footer class="border-t border-white/10 py-14">
  <div class="shell grid gap-12 md:grid-cols-[1.1fr_2fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="grid size-7 place-items-center rounded-md bg-signal/15 font-mono text-xs font-semibold text-signal">e</span>
        <span class="text-sm font-semibold tracking-tight">exist.io</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-fg-3">
        A self-hosted Git forge for people and coding agents.
      </p>
      <p class="mt-8 font-mono text-[11px] text-fg-3">{footer.legal}</p>
    </div>

    <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4" aria-label="Footer">
      {footer.columns.map((column) => (
        <div>
          <h2 class="text-xs font-semibold text-fg">{column.title}</h2>
          <ul class="mt-3 space-y-2">
            {column.links.map((link) => (
              <li>
                <a class="text-xs text-fg-3 transition-colors hover:text-fg" href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
