---
import { marketing } from "../../content/marketing";
const { footer } = marketing;
---

<footer class="bg-surface py-16">
  <div class="shell grid gap-12 md:grid-cols-[1.2fr_2fr]">
    <div data-reveal>
      <p class="heading">exist.io</p>
      <p class="body mt-4 max-w-xs">A self-hosted Git forge for people and coding agents.</p>
      <p class="small mt-8">{footer.legal}</p>
    </div>

    <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4" aria-label="Footer" data-reveal>
      {footer.columns.map((column) => (
        <div>
          <h2 class="text-sm font-semibold text-fg">{column.title}</h2>
          <ul class="mt-3 space-y-2">
            {column.links.map((link) => (
              <li>
                <a class="small transition-colors hover:text-fg" href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
