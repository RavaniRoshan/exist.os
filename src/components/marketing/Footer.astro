---
import { marketing } from "../../content/marketing";
const { footer, nav } = marketing;
---

<footer class="pt-16">
  <div class="shell">
    <div class="flex flex-col gap-8 border-b border-line pb-10 md:flex-row md:items-end md:justify-between">
      <div data-reveal>
        <p class="mega leading-[0.8]">exist.io</p>
        <p class="small mt-4 max-w-xs">{footer.tagline}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3" data-reveal>
        <a class="btn btn-primary h-9" href="#quickstart">Install</a>
        <a class="btn btn-ghost h-9" href={nav.github}>Star on GitHub ↗</a>
      </div>
    </div>

    <nav class="grid grid-cols-2 gap-8 py-10 sm:grid-cols-4" aria-label="Footer" data-reveal>
      {footer.columns.map((column) => (
        <div>
          <h2 class="eyebrow">{column.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li><a class="text-sm text-ink-2 transition-colors hover:text-ink" href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line py-5 text-xs text-ink-3">
      <span class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-mint" aria-hidden="true"></span>
        {footer.status} · self-hosted · {footer.legal}
      </span>
      <span>GitHub · Docs · Claims ledger</span>
    </div>
  </div>
</footer>
