---
import { marketing } from "../../content/marketing";
import git from "../../assets/logos/git.svg?raw";
import gitlfs from "../../assets/logos/gitlfs.svg?raw";
import gnupg from "../../assets/logos/gnupg.svg?raw";
import sqlite from "../../assets/logos/sqlite.svg?raw";
import mcp from "../../assets/logos/modelcontextprotocol.svg?raw";
import openid from "../../assets/logos/openid.svg?raw";
import terraform from "../../assets/logos/terraform.svg?raw";
import helm from "../../assets/logos/helm.svg?raw";
import kubernetes from "../../assets/logos/kubernetes.svg?raw";
import prometheus from "../../assets/logos/prometheus.svg?raw";

const logos: Record<string, string> = { git, gitlfs, gnupg, sqlite, modelcontextprotocol: mcp, openid, terraform, helm, kubernetes, prometheus };
const { integrations } = marketing;
---

<section id="platform" class="border-b border-line">
  <div class="shell py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">{integrations.eyebrow}</p>
        <h2 class="heading mt-3 max-w-xl">{integrations.title}</h2>
        <p class="body mt-3 max-w-lg">{integrations.body}</p>
      </div>
      <span class="tag">{integrations.items.length} integrations</span>
    </div>

    <div class="mt-12 trust-grid">
      {integrations.items.map((item, index) => (
        <a class="trust-item group" href={item.url} target="_blank" rel="noopener noreferrer" data-reveal style={{ "--delay": `${index * 0.06}s` }}>
          <span class="logo text-ink-3 [&_svg]:size-6 transition-colors group-hover:text-mint" set:html={logos[item.logo]} />
          <span class="sr-only">{item.name} — {item.kind}</span>
        </a>
      ))}
    </div>
  </div>
</section>
