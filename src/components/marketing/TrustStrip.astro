---
import { marketing } from "../../content/marketing";
const { trust } = marketing;
---

<section class="bg-surface py-12">
  <div class="shell">
    <p class="text-lg font-medium text-fg-2" data-reveal>{trust.label}</p>
    <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-2">
      {trust.items.map((item) => (
        <li class="small" data-reveal>{item}</li>
      ))}
    </ul>
  </div>
</section>
