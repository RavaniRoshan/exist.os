---
import { marketing } from "../../content/marketing";
const { cta } = marketing;
---

<section class="border-b border-line">
  <div class="shell py-16 md:py-24">
    <div class="relative overflow-hidden rounded-2xl border border-line bg-warm px-6 py-14 md:px-14 md:py-20" data-reveal>
      <svg
        class="pointer-events-none absolute -right-24 top-1/2 size-[460px] -translate-y-1/2 text-ink/15 md:-right-10 md:size-[540px]"
        viewBox="0 0 400 400"
        fill="none"
        aria-hidden="true"
      >
        <circle class="cta-ring" cx="200" cy="200" r="150" stroke="currentColor" stroke-dasharray="8 16" />
        <circle class="cta-ring-reverse" cx="200" cy="200" r="112" stroke="currentColor" stroke-dasharray="2 10" />
        <circle cx="200" cy="200" r="72" stroke="var(--color-mint)" stroke-opacity="0.45" />
        <circle cx="200" cy="200" r="4" fill="var(--color-mint)" fill-opacity="0.7" />
      </svg>

      <div class="relative max-w-xl">
        <p class="eyebrow">Deploy it yourself</p>
        <h2 class="mt-3 text-[clamp(2.4rem,5vw,4rem)] font-light leading-[0.95] tracking-[-0.045em]">{cta.title}</h2>
        <p class="body mt-4 max-w-md">{cta.body}</p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary" href={cta.primary.href}>{cta.primary.label}</a>
          <a class="btn btn-ghost bg-warm/60" href={cta.secondary.href}>{cta.secondary.label}</a>
        </div>
        <p class="small mt-5">{cta.note}</p>
      </div>
    </div>
  </div>
</section>
