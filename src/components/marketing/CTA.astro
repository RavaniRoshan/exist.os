---
import { marketing } from "../../content/marketing";
const { cta } = marketing;
---

<section class="pb-20 md:pb-28">
  <div class="shell">
    <div class="surface px-6 py-16 text-center md:px-16 md:py-20" data-reveal>
      <h2 class="heading">{cta.title}</h2>
      <p class="body mx-auto mt-4 max-w-xl">{cta.body}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-7">
        <a class="btn btn-primary" href={cta.primary.href}>{cta.primary.label}</a>
        <a class="text-link" href={cta.secondary.href}>{cta.secondary.label}</a>
      </div>
    </div>
  </div>
</section>
