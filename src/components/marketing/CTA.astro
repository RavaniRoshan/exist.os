---
import { marketing } from "../../content/marketing";
const { cta } = marketing;
---

<section class="pb-20 md:pb-28">
  <div class="shell">
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-surface px-6 py-16 text-center md:px-16">
      <div class="hero-glow pointer-events-none absolute inset-0 opacity-70"></div>
      <div class="relative">
        <h2 class="text-3xl font-semibold md:text-5xl">{cta.title}</h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-fg-2">{cta.body}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="btn btn-primary" href={cta.primary.href}>{cta.primary.label}</a>
          <a class="btn btn-ghost" href={cta.secondary.href}>{cta.secondary.label}</a>
        </div>
      </div>
    </div>
  </div>
</section>
