---
import { marketing } from "../../content/marketing";
const { pillars } = marketing;
---

<section class="py-20 md:py-28">
  <div class="shell grid gap-4 md:grid-cols-3">
    {pillars.map((pillar) => (
      <div class="card card-hover p-6 md:p-7">
        <h2 class="text-lg font-semibold">{pillar.title}</h2>
        <p class="mt-3 text-sm leading-relaxed text-fg-2">{pillar.body}</p>
        <p class="mt-6 font-mono text-[11px] text-fg-3">{pillar.detail}</p>
      </div>
    ))}
  </div>
</section>
