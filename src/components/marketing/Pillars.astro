---
import { marketing } from "../../content/marketing";
const { pillars } = marketing;
---

<section class="py-20 md:py-28">
  <div class="shell">
    <h2 class="heading max-w-2xl" data-reveal>Built on three decisions.</h2>

    <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-12">
      {pillars.map((pillar) => (
        <div data-reveal>
          <h3 class="text-xl font-semibold">{pillar.title}</h3>
          <p class="body mt-3">{pillar.body}</p>
          <p class="small mt-5">{pillar.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
