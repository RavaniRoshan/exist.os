---
const base = import.meta.env.BASE_URL;
---

<section class="py-20 md:py-28">
  <div class="shell">
    <h2 class="heading max-w-2xl" data-reveal>One dashboard for humans and agents.</h2>
    <p class="body mt-4 max-w-2xl" data-reveal>
      Repository activity, agent leases, pull requests, and cluster state in the same view. No separate admin console and no mock data.
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <figure data-reveal>
        <img
          src={`${base}/forge-home.png`}
          alt="exist.io home dashboard with activity feed and cluster telemetry"
          width="1440"
          height="900"
          class="w-full"
          loading="lazy"
        />
        <figcaption class="small mt-3">Repository home and activity feed.</figcaption>
      </figure>
      <figure data-reveal>
        <img
          src={`${base}/forge-agents.png`}
          alt="exist.io agent console with capability leases and tool activity"
          width="1440"
          height="900"
          class="w-full"
          loading="lazy"
        />
        <figcaption class="small mt-3">Agent console and capability leases.</figcaption>
      </figure>
    </div>
  </div>
</section>
