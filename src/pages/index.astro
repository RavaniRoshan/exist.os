---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/marketing/Nav.astro";
import Hero from "../components/marketing/Hero.astro";
import TrustStrip from "../components/marketing/TrustStrip.astro";
import Pillars from "../components/marketing/Pillars.astro";
import FeatureSplit from "../components/marketing/FeatureSplit.astro";
import Bento from "../components/marketing/Bento.astro";
import Quickstart from "../components/marketing/Quickstart.astro";
import CTA from "../components/marketing/CTA.astro";
import Footer from "../components/marketing/Footer.astro";
import { marketing } from "../content/marketing";
---

<BaseLayout title={marketing.meta.title} description={marketing.meta.description}>
  <Nav />
  <main>
    <Hero />
    <TrustStrip />
    <Pillars />
    {marketing.features.map((feature, index) => (
      <FeatureSplit feature={feature} index={index} />
    ))}
    <Bento />
    <Quickstart />
    <CTA />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initCopy } from "../scripts/copy";
  initCopy();
</script>
