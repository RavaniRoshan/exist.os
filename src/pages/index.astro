---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/marketing/Nav.astro";
import Hero from "../components/marketing/Hero.astro";
import Preview from "../components/marketing/Preview.astro";
import Features from "../components/marketing/Features.astro";
import Integrations from "../components/marketing/Integrations.astro";
import Proof from "../components/marketing/Proof.astro";
import Quickstart from "../components/marketing/Quickstart.astro";
import CTA from "../components/marketing/CTA.astro";
import Footer from "../components/marketing/Footer.astro";
import { marketing } from "../content/marketing";
---

<BaseLayout title={marketing.meta.title} description={marketing.meta.description}>
  <Nav />
  <main>
    <Hero />
    <Preview />
    <Features />
    <Integrations />
    <Proof />
    <Quickstart />
    <CTA />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initLanding } from "../scripts/landing";
  initLanding();
</script>
